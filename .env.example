# Supabase — required for authentication features (optional for anonymous mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Propagation V4.2 service. Shadow scores silently; active exposes model UI.
VITE_PROPAGATION_V4_MODE=shadow
VITE_PROPAGATION_MODEL_URL=http://localhost:8000

# Inference service telemetry mode (server-side, never exposed to the browser)
PROPULSE_INFERENCE_MODE=shadow

# Server-only verified WSPR lag feature store. Leave all three blank until the
# provider/use is approved and the feature-store migration/replay gates pass.
PROPULSE_FEATURE_STORE_URL=
PROPULSE_FEATURE_STORE_SERVICE_KEY=
PROPULSE_WSPR_PROVIDER=
PROPULSE_PATH_TRANSFORM_VERSION=wspr-opportunity-duckdb-v1

# HamQTH — callsign lookup bio/location data (free account at hamqth.com)
HAMQTH_USERNAME=
HAMQTH_PASSWORD=

# NASA FIRMS — fire hotspot data (free key from firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
