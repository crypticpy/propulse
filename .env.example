# Supabase — required for authentication features (optional for anonymous mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Propagation V4.2 product visibility. Internal displays experimental capabilities.
# Released displays only evidence-eligible modes approved by the checksum-bound
# M5 runtime activation contract. Legacy shadow/active values remain accepted
# during migration as aliases for internal/released.
VITE_PROPAGATION_V4_MODE=internal
VITE_PROPAGATION_MODEL_URL=http://localhost:8000

# Live map sources are always on — no enable flags. Optional overrides:
# Lightning collector service (defaults to the Railway deployment if unset)
COLLECTOR_URL=
# APRS.fi API key — the APRS layer returns no stations until this is set
# (free key from aprs.fi account settings)
APRS_FI_API_KEY=
# RepeaterBook approved-client token — the repeaters layer returns no sites
# until this is set (apply at repeaterbook.com; free for non-commercial)
REPEATERBOOK_APP_TOKEN=

# Independent opt-in beta outcome collection. Keep both false until policy
# review, source authorization, active beta approval, and the evidence-derived
# runtime activation contract all pass.
VITE_PROPAGATION_RESEARCH_OUTCOMES_ENABLED=false
PROPULSE_PROPAGATION_RESEARCH_OUTCOMES_ENABLED=false
# Shared only by the inference service and product API; use 32+ random chars.
PROPULSE_RESEARCH_RECEIPT_SECRET=
# Server-only aggregate stop-counter RPC. Configure both before receipt signing.
PROPULSE_BETA_TELEMETRY_STORE_URL=
PROPULSE_BETA_TELEMETRY_STORE_SERVICE_KEY=
# Weekly safety monitor remains disabled until the approved beta starts.
PROPULSE_STATIONCAST_BETA_MONITOR_ENABLED=false

# Inference service telemetry mode (server-side, never exposed to the browser)
PROPULSE_INFERENCE_MODE=shadow

# Server-only verified WSPR lag feature store. Leave all three blank until the
# provider/use is approved and the feature-store migration/replay gates pass.
PROPULSE_FEATURE_STORE_URL=
PROPULSE_FEATURE_STORE_SERVICE_KEY=
PROPULSE_WSPR_PROVIDER=
PROPULSE_PATH_TRANSFORM_VERSION=wspr-opportunity-duckdb-v1

# HamQTH — callsign lookup bio/location data (free account at hamqth.com)
HAMQTH_USERNAME=
HAMQTH_PASSWORD=

# NASA FIRMS — fire hotspot data (free key from firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Air quality — either key enables the AQI half of the Environment card
# (AirNow: free key from docs.airnowapi.org; WAQI: free token from aqicn.org/data-platform/token/)
AIRNOW_API_KEY=
WAQI_TOKEN=
