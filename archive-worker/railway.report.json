{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "archive-worker/Dockerfile",
    "watchPatterns": [
      "archive-worker/**",
      "supabase/migrations/202607190*.sql"
    ]
  },
  "deploy": {
    "startCommand": "python -m propagation_archive report --include-exact-rates",
    "cronSchedule": "30 4 * * 1",
    "restartPolicyType": "NEVER"
  }
}
