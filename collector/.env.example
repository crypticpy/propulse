# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional
AGGREGATION_SETTLE_MINUTES=20
# Separate destructive switch for clearing forecast JSON after verified archive.
ARCHIVE_FORECAST_COMPACTION_ENABLED=false
ARCHIVE_PRUNE_BATCH_SIZE=10000
# Fail closed. Do not enable until sealed archive fixtures and restore gates pass.
ARCHIVE_PRUNING_ENABLED=false
COLLECTOR_ENABLED_SOURCES=pskreporter,rbn,solar,forecasts,lightning,satellites
COLLECTOR_LOG_LEVEL=info
POLL_FORECASTS=21600
POLL_FORECAST_SNAPSHOT=300
PORT=8080
RBN_LOGIN_CALLSIGN=your-receive-only-callsign
RBN_SAMPLE_PERCENT=5
