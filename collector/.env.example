# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional
AGGREGATION_SETTLE_MINUTES=20
# Separate destructive switch for clearing forecast JSON after verified archive.
ARCHIVE_FORECAST_COMPACTION_ENABLED=false
ARCHIVE_PRUNE_BATCH_SIZE=10000
# Fail closed. Do not enable until sealed archive fixtures and restore gates pass.
ARCHIVE_PRUNING_ENABLED=false
# path_hourly_stats day archiver: exports always run; deleting archived days
# from the hot table is fail closed behind ARCHIVE_PATH_STATS_PRUNE.
ARCHIVE_PATH_STATS_HOT_DAYS=90
ARCHIVE_PATH_STATS_PRUNE=false
ARCHIVE_PATH_STATS_MAX_DAYS_PER_RUN=2
# /health degrades when the database exceeds this size (MB)
DB_SIZE_BUDGET_MB=3072
COLLECTOR_ENABLED_SOURCES=pskreporter,rbn,solar,forecasts,lightning,satellites
COLLECTOR_LOG_LEVEL=info
POLL_BAND_CLIMATOLOGY=86400
POLL_DB_SIZE_GUARD=21600
POLL_FORECASTS=21600
POLL_FORECAST_SNAPSHOT=300
POLL_PATH_ARCHIVE=3600
POLL_VERDICT_LADDER=300
PORT=8080
RBN_LOGIN_CALLSIGN=your-receive-only-callsign
RBN_SAMPLE_PERCENT=5
