{
  "name": "propulse-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Propulse 24/7 spot and solar data collector",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "forecast:once": "node dist/forecastArchive.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "mqtt": "^5.15.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
