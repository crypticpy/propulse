{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crypticpy/propulse/ml/config/propagation_v4.schema.json",
  "title": "Propulse Personalized Propagation V4 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "seed",
    "baseline_commit",
    "splits",
    "sampling",
    "models",
    "future_horizons_hours",
    "gates"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "archive_namespace": { "const": "archive_v4" },
    "seed": { "type": "integer" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "locked_archive_test", "locked_prospective_test"],
      "properties": {
        "train": { "$ref": "#/$defs/monthList" },
        "validation": { "$ref": "#/$defs/monthList" },
        "locked_archive_test": { "$ref": "#/$defs/monthList" },
        "locked_prospective_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_train_rows", "learning_curve_rows", "validation_rows", "strata"],
      "properties": {
        "primary_train_rows": { "const": 50000000 },
        "learning_curve_rows": {
          "type": "array",
          "prefixItems": [
            { "const": 5000000 },
            { "const": 20000000 },
            { "const": 50000000 }
          ],
          "items": false
        },
        "validation_rows": { "type": "integer", "minimum": 1 },
        "strata": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "future_horizons_hours": {
      "type": "array",
      "prefixItems": [
        { "const": 3 },
        { "const": 6 },
        { "const": 12 },
        { "const": 24 }
      ],
      "items": false
    },
    "gates": { "type": "object", "minProperties": 8 },
    "compute": { "type": "object" },
    "months": { "$ref": "#/$defs/monthList" },
    "train": { "type": "object" },
    "validation": { "type": "object" },
    "validation_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["early_stopping_months", "calibration_months", "gate_months"],
      "properties": {
        "early_stopping_months": { "$ref": "#/$defs/monthList" },
        "calibration_months": { "$ref": "#/$defs/monthList" },
        "gate_months": { "$ref": "#/$defs/monthList" }
      }
    },
    "test": { "type": "object" },
    "negative_receivers_per_tx_slot": { "type": "integer", "minimum": 1 },
    "primary_train_rows": { "const": 50000000 },
    "validation_rows": { "type": "integer", "minimum": 1 },
    "xgboost_rounds": { "type": "integer", "minimum": 1 },
    "early_stopping_rounds": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "monthList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^20[0-9]{2}-(01|04|07|10)$" }
    }
  }
}
