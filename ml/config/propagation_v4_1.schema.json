{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crypticpy/propulse/ml/config/propagation_v4_1.schema.json",
  "title": "Propulse Personalized Propagation V4.1 calibration recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "archive_namespace",
    "seed",
    "plan_commit",
    "parent_run_id",
    "parent_evidence_commit",
    "data_roles",
    "frozen_candidates",
    "calibration",
    "gates",
    "compute"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "run_id": {"const": "propagation_v4_1_calibration_recovery"},
    "archive_namespace": {"const": "archive_v4_1"},
    "seed": {"const": 20260712},
    "plan_commit": {"const": "2af85f5"},
    "parent_run_id": {"const": "propagation_v4_multiyear_50m"},
    "parent_evidence_commit": {"const": "2cb309d"},
    "data_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_core_train",
        "frozen_early_stopping",
        "calibration_development",
        "new_calibration_sources",
        "observed_engineering",
        "untouched_development_gate",
        "reserved_future_version",
        "locked_archive_test",
        "locked_prospective_test"
      ],
      "properties": {
        "frozen_core_train": {"$ref": "#/$defs/months"},
        "frozen_early_stopping": {"$ref": "#/$defs/months"},
        "calibration_development": {"$ref": "#/$defs/months"},
        "new_calibration_sources": {"$ref": "#/$defs/months"},
        "observed_engineering": {"$ref": "#/$defs/months"},
        "untouched_development_gate": {"$ref": "#/$defs/months"},
        "reserved_future_version": {"$ref": "#/$defs/months"},
        "locked_archive_test": {"$ref": "#/$defs/months"},
        "locked_prospective_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"}
          }
        }
      }
    },
    "frozen_candidates": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "minProperties": 6
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_candidate",
        "candidate_ids",
        "serving_distance_bins_km",
        "audit_distance_bins_km",
        "minimum_rows",
        "minimum_positive_equivalent",
        "minimum_negative_equivalent",
        "minimum_months",
        "sufficient_statistic_bins",
        "stream_batch_rows",
        "bootstrap_repetitions",
        "bootstrap_upper_bound",
        "tie_order",
        "probability_clip"
      ],
      "properties": {
        "primary_candidate": {"const": "C4_guarded_hierarchical_isotonic"},
        "candidate_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "serving_distance_bins_km": {"$ref": "#/$defs/numericBins"},
        "audit_distance_bins_km": {"$ref": "#/$defs/numericBins"},
        "minimum_rows": {"const": 10000},
        "minimum_positive_equivalent": {"const": 1000.0},
        "minimum_negative_equivalent": {"const": 1000.0},
        "minimum_months": {"const": 3},
        "sufficient_statistic_bins": {"const": 262144},
        "stream_batch_rows": {"type": "integer", "minimum": 10000},
        "bootstrap_repetitions": {"const": 2000},
        "bootstrap_upper_bound": {"const": 0.0},
        "tie_order": {"type": "array", "minItems": 4, "maxItems": 4},
        "probability_clip": {
          "type": "array",
          "prefixItems": [{"const": 0.0000001}, {"const": 0.9999999}],
          "items": false
        }
      }
    },
    "gates": {"type": "object", "minProperties": 10},
    "compute": {
      "type": "object",
      "required": ["required_profile", "primary_machine", "data_root", "model_root", "temp_root"],
      "properties": {"required_profile": {"const": "m5"}}
    }
  },
  "$defs": {
    "months": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"}
    },
    "numericBins": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "number", "minimum": 0}
    }
  }
}
