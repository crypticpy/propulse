{
  "name": "propulse",
  "private": true,
  "version": "0.16.0",
  "description": "Ham radio operator toolset - solar weather and propagation visualization",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:session": "node scripts/dev-session.mjs",
    "test:dev-session": "node --test scripts/dev-session.test.mjs",
    "test:hamclock:browser": "node scripts/check-hamclock-display.mjs",
    "build": "tsc -b && vite build",
    "test": "npm run test:station-postgres-harness && vitest run",
    "test:station-postgres-harness": "node --test scripts/lib/station-postgres-harness.test.mjs",
    "test:watch": "vitest",
    "test:solar": "vitest run src/lib/solar src/lib/api/solarClient.test.ts src/lib/utils/idbCache.test.ts src/hooks/projectSolarResource.test.ts src/components/solar src/components/ui/AccessibleDialog.test.tsx api/_lib/solarHandler.test.ts",
    "test:solar:browser": "playwright test",
    "check:solar:synthetic": "node scripts/check-solar-providers.mjs",
    "test:bridge": "npm --prefix bridge run test",
    "test:radio-daemon": "cd daemon && cargo test -p propulse-daemon",
    "lint": "eslint . --max-warnings 0",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:tracked-artifacts": "node scripts/check-tracked-artifacts.mjs",
    "check:v4-preregistration": "ml/.venv/bin/python ml/src/archive_v4/validate_preregistration.py && ml/.venv/bin/python -m unittest discover -s ml/src/archive_v4/tests && ml/.venv/bin/python -m unittest discover -s ml/service",
    "check:v4.1-preregistration": "ml/.venv/bin/python ml/src/archive_v4_1/validate_preregistration.py && ml/.venv/bin/python -m unittest discover -s ml/src/archive_v4_1/tests",
    "check:v4.2": "ml/.venv/bin/python -m unittest discover -s ml/src/archive_v4_2/tests",
    "check:archive": "PYTHONPATH=archive-worker ml/.venv/bin/python -m unittest discover -s archive-worker/tests",
    "check:archive-integration": "PYTHONPATH=archive-worker ml/.venv/bin/python archive-worker/tests/run_local_fixture_gate.py --confirm-disposable-local-database",
    "check:storage-cutovers": "psql ${PROPULSE_TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres} -f archive-worker/tests/partition_compact_integration.sql",
    "check:archive-concurrency": "PYTHONPATH=archive-worker ml/.venv/bin/python archive-worker/tests/run_lock_integration.py --confirm-disposable-local-database",
    "check:research-retention": "psql ${PROPULSE_TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres} -f archive-worker/tests/research_retention_integration.sql",
    "check:production-boundaries": "node scripts/check-propagation-production-boundaries.mjs",
    "check:cloud-smoke": "node scripts/check-propagation-cloud-smoke.mjs",
    "check:propagation-load": "node scripts/load-test-propagation.mjs",
    "check:push-size": "node scripts/check-push-size.mjs",
    "verify": "npm run check:tracked-artifacts && npm run check:v4-preregistration && npm run check:v4.1-preregistration && npm run check:v4.2 && npm run check:archive && npm run check:production-boundaries && npm run lint && npm run test && npm run test:bridge && npm run test:radio-daemon && npm run build && npm run check:bundles",
    "verify:radio": "npm run lint && npm run test && npm run test:bridge && npm run test:radio-daemon && npm run build",
    "hooks:install": "bash scripts/setup-git-hooks.sh",
    "preview": "vite preview",
    "import:sherwood": "node scripts/import-sherwood.mjs",
    "bridge": "cd bridge && npm run dev",
    "bridge:build": "cd bridge && npm run build",
    "rank:manifest": "node scripts/generate-rank-manifest.mjs",
    "fixture:owner": "node scripts/seed-owner-fixture.mjs",
    "test:owner-fixture": "node --test scripts/seed-owner-fixture.test.mjs",
    "eval:forecast": "node scripts/eval-forecast.mjs",
    "test:eval-forecast": "node --test scripts/lib/forecast-eval-core.test.mjs",
    "test:home:browser": "playwright test --config playwright.home.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.62.8",
    "@types/qrcode": "^1.5.6",
    "@vercel/speed-insights": "^1.3.1",
    "3d-tiles-renderer": "^0.4.21",
    "date-fns": "^4.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.19.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^7.1.1",
    "satellite.js": "^6.0.2",
    "suncalc": "^1.9.0",
    "three": "^0.182.0",
    "us-atlas": "^3.0.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
