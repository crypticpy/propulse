// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Solar Pulse structural snapshot (DS-03 retheme) > BandConditionsModal: the full band matrix 1`] = `"<div aria-hidden="true"></div><div><button type="button" aria-label="Dismiss dialog" tabindex="-1"></button><div role="dialog" aria-modal="true" aria-labelledby=":r2:" aria-describedby=":r3:" tabindex="-1"><header><div><h2 id=":r2:">HF Band Conditions</h2><p id=":r3:">Complete band analysis and propagation guide</p></div><button type="button" aria-label="Close dialog"><span aria-hidden="true">×</span></button></header><div><div><div><div><span>Solar Flux</span><span>150 sfu</span></div><div><span>K-Index</span><span>3</span></div><div><span>Local Time</span><span>02:30 PM</span></div><div><span>Period</span><span>Daytime</span></div></div><div><h4>Band Condition Matrix</h4><div><table><thead><tr><th>Band</th><th>Frequency</th><th>Day</th><th>Night</th><th>Best For</th><th>DX Window</th></tr></thead><tbody><tr><td><span>160m</span></td><td>1.8 MHz</td><td><span>Poor</span></td><td><span>Fair</span></td><td>Night DX, regional</td><td>21:00 - 06:00 local</td></tr><tr><td><span>80m</span></td><td>3.5 MHz</td><td><span>Poor</span></td><td><span>Fair</span></td><td>Night DX, regional nets</td><td>21:00 - 06:00 local</td></tr><tr><td><span>60m</span></td><td>5.3 MHz</td><td><span>Poor</span></td><td><span>Fair</span></td><td>NVIS, emergency</td><td>Any time (NVIS)</td></tr><tr><td><span>40m</span></td><td>7 MHz</td><td><span>Poor</span></td><td><span>Fair</span></td><td>All-day workhorse</td><td>24/7 (best at twilight)</td></tr><tr><td><span>30m</span></td><td>10 MHz</td><td><span>Fair</span></td><td><span>Fair</span></td><td>CW/digital, day/night</td><td>Day/twilight</td></tr><tr><td><span>20m</span></td><td>14 MHz</td><td><span>Fair</span></td><td><span>Fair</span></td><td>Daytime DX</td><td>08:00 - 18:00 local</td></tr><tr><td><span>17m</span></td><td>18 MHz</td><td><span>Fair</span></td><td><span>Poor</span></td><td>Daytime DX</td><td>10:00 - 16:00 local</td></tr><tr><td><span>15m</span></td><td>21 MHz</td><td><span>Fair</span></td><td><span>Poor</span></td><td>Daytime DX, contests</td><td>10:00 - 15:00 local</td></tr><tr><td><span>12m</span><span>*</span></td><td>24 MHz</td><td><span>Good</span></td><td><span>Poor</span></td><td>Solar max DX</td><td>11:00 - 14:00 local</td></tr><tr><td><span>10m</span><span>*</span></td><td>28 MHz</td><td><span>Good</span></td><td><span>Poor</span></td><td>Solar max DX, local</td><td>11:00 - 14:00 local</td></tr><tr><td><span>6m</span></td><td>50 MHz</td><td><span>Poor</span></td><td><span>Poor</span></td><td>Sporadic E, tropo</td><td>Variable (check spots)</td></tr></tbody></table></div><p>* Recommended bands for current time and conditions</p></div><div><h4>Band Details and Propagation Modes</h4><div><div><div><div><div><span>160m</span><span>1.8 MHz</span><span>(Top Band)</span></div><p>The most challenging HF band. Requires large antennas and high power for DX. Subject to significant atmospheric noise in summer.</p><div><div><span>Propagation Modes:</span><div><span>Ground wave</span><span>NVIS</span><span>F2 skip (rare)</span></div></div><div><span>Typical Range:</span><span>Regional to 500+ miles at night</span></div><div><span>Best Time:</span><span>Night (local sunset to sunrise)</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Poor</span><span>Night:</span><span>Fair</span></span></div></div></div></div></div><div><div><div><div><span>80m</span><span>3.5 MHz</span><span>(75/80m)</span></div><p>Excellent for regional nets and night-time DX. Higher noise levels than daytime bands. Split between phone (75m) and CW/digital (80m).</p><div><div><span>Propagation Modes:</span><div><span>Ground wave</span><span>NVIS</span><span>F2 skip</span></div></div><div><span>Typical Range:</span><span>Regional to continental</span></div><div><span>Best Time:</span><span>Night and twilight hours</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Poor</span><span>Night:</span><span>Fair</span></span></div></div></div></div></div><div><div><div><div><span>60m</span><span>5.3 MHz</span><span>(5 MHz channels)</span></div><p>Channelized band primarily for emergency communications. Excellent NVIS coverage. Not available in all countries.</p><div><div><span>Propagation Modes:</span><div><span>NVIS</span><span>Ground wave</span></div></div><div><span>Typical Range:</span><span>0-500 miles typical</span></div><div><span>Best Time:</span><span>Any time (NVIS optimized)</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Poor</span><span>Night:</span><span>Fair</span></span></div></div></div></div></div><div><div><div><div><span>40m</span><span>7 MHz</span><span>(Workhorse band)</span></div><p>The most reliable DX band at any point in the solar cycle. Day and night operation. First choice when unsure of conditions.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span><span>NVIS (day)</span><span>Ground wave</span></div></div><div><span>Typical Range:</span><span>Regional to worldwide</span></div><div><span>Best Time:</span><span>24/7 reliable</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Poor</span><span>Night:</span><span>Fair</span></span></div></div></div></div></div><div><div><div><div><span>30m</span><span>10 MHz</span><span>(WARC band)</span></div><p>CW and digital only (no phone). Quieter than 40m with excellent propagation characteristics. Popular for FT8 and digital modes.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span></div></div><div><span>Typical Range:</span><span>Continental to worldwide</span></div><div><span>Best Time:</span><span>Day and night</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Fair</span><span>Night:</span><span>Fair</span></span></div></div></div></div></div><div><div><div><div><span>20m</span><span>14 MHz</span><span>(Primary DX band)</span></div><p>The king of DX bands. Open to somewhere in the world almost always during daylight. First choice for daytime DX operations.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span><span>Multi-hop</span></div></div><div><span>Typical Range:</span><span>Worldwide during day</span></div><div><span>Best Time:</span><span>Daylight hours (local)</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Fair</span><span>Night:</span><span>Fair</span></span></div></div></div></div></div><div><div><div><div><span>17m</span><span>18 MHz</span><span>(WARC band)</span></div><p>Excellent DX band when open. Less crowded than 20m or 15m. Requires moderate solar activity (SFI &gt; 90) for reliable openings.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span></div></div><div><span>Typical Range:</span><span>Continental to worldwide</span></div><div><span>Best Time:</span><span>Daylight hours</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Fair</span><span>Night:</span><span>Poor</span></span></div></div></div></div></div><div><div><div><div><span>15m</span><span>21 MHz</span><span>(Contest favorite)</span></div><p>Outstanding DX band during moderate to high solar activity. Very quiet band when closed. Popular for contests.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span><span>Sporadic E</span></div></div><div><span>Typical Range:</span><span>Worldwide when open</span></div><div><span>Best Time:</span><span>Late morning to afternoon</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Fair</span><span>Night:</span><span>Poor</span></span></div></div></div></div></div><div><div><div><div><span>12m</span><span>24 MHz</span><span>(WARC band)</span><span>OPEN NOW</span></div><p>Requires good solar activity (SFI &gt; 100) for F2 openings. Can have excellent sporadic E openings in summer.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span><span>Sporadic E</span></div></div><div><span>Typical Range:</span><span>Worldwide when open</span></div><div><span>Best Time:</span><span>Midday</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Good</span><span>Night:</span><span>Poor</span></span></div></div></div></div></div><div><div><div><div><span>10m</span><span>28 MHz</span><span>(Magic band for HF)</span><span>OPEN NOW</span></div><p>Excellent for worldwide DX at solar maximum. Very quiet when closed. Summer sporadic E can provide regional contacts regardless of solar cycle.</p><div><div><span>Propagation Modes:</span><div><span>F2 skip</span><span>Sporadic E</span><span>Tropo</span></div></div><div><span>Typical Range:</span><span>Worldwide when open</span></div><div><span>Best Time:</span><span>Midday during high solar activity</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Good</span><span>Night:</span><span>Poor</span></span></div></div></div></div></div><div><div><div><div><span>6m</span><span>50 MHz</span><span>(Magic band)</span></div><p>Fascinating band with unpredictable propagation. Multiple propagation modes. Requires patience and antenna pointing.</p><div><div><span>Propagation Modes:</span><div><span>Sporadic E</span><span>F2 (rare)</span><span>Tropo</span><span>Aurora</span><span>Meteor scatter</span></div></div><div><span>Typical Range:</span><span>Variable - local to worldwide</span></div><div><span>Best Time:</span><span>Summer (Es), Solar max (F2)</span></div><div><span>Current Conditions:</span><span><span>Day:</span><span>Poor</span><span>Night:</span><span>Poor</span></span></div></div></div></div></div></div></div><div><h4>Propagation Mode Guide</h4><div><div><h5>F2 Skip (Ionospheric)</h5><p>Primary long-distance HF mode. Radio waves refract off the F2 layer of the ionosphere (200-400 km altitude). Effectiveness depends on solar activity - higher SFI means better F2 propagation on higher bands.</p></div><div><h5>Sporadic E (Es)</h5><p>Unpredictable propagation via dense patches in the E layer (100-120 km). Common in summer months. Can provide excellent 6m, 10m, and 12m openings regardless of solar cycle. Watch for sudden band openings.</p></div><div><h5>NVIS (Near Vertical)</h5><p>Signals sent nearly straight up reflect back down, providing coverage out to ~300 miles with no skip zone. Ideal for emergency communications on 40m, 60m, and 80m during daylight.</p></div><div><h5>Ground Wave</h5><p>Direct propagation following Earth's surface. Reliable for short distances (typically under 100 miles on HF). Range depends on frequency, power, and terrain. Primary mode for local contacts on lower bands.</p></div><div><h5>Aurora</h5><p>Signals reflect off the auroral curtain during geomagnetic storms (high K-index). Produces characteristic "flutter" on signals. Primarily affects 6m and 2m. Point antennas toward the aurora.</p></div><div><h5>Tropospheric (Tropo)</h5><p>VHF/UHF signals bend in temperature inversions in the troposphere. Common during stable high-pressure weather patterns. Can provide extended range on 6m and above. Watch for ducting conditions.</p></div></div></div><div><h4>Condition Legend</h4><div><div><span>Excellent</span><span>Worldwide DX possible</span></div><div><span>Good</span><span>Reliable DX</span></div><div><span>Fair</span><span>Limited openings</span></div><div><span>Poor</span><span>Band closed or very weak</span></div><div><span>Aurora</span><span>Aurora scatter possible</span></div></div></div></div></div></div></div>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarBriefingCard: impact tone with evidence open 1`] = `"<section aria-label="HF briefing"><div><p>Your HF briefing · global context</p><span role="status">Updates pending</span></div><h2>Elevated geomagnetic activity may affect high-latitude paths</h2><div><p>Kp reached 5 in the last interval.</p></div><button type="button" aria-expanded="false">Why this briefing?</button><p>Updates are delayed for Solar flux. Propulse checks again automatically; no setting needs changing. Unreported conditions remain uncertain.</p><div aria-label="Official NOAA scales"><p><strong>R —</strong>Radio blackout</p><p><strong>S —</strong>Radiation storm</p><p><strong>G —</strong>Geomagnetic</p></div><p>Actions</p><div><p>Global conditions describe the backdrop. A contact depends on both stations and the path.</p><button type="button" aria-expanded="true" aria-controls="solar-briefing-evidence">Hide sources</button></div><div id="solar-briefing-evidence"><p>Each statement uses the products below. Delayed readings remain visible only within their product's usability window.</p><ul><li><a href="https://example.test/kp" target="_blank" rel="noreferrer">Planetary Kp</a> · fresh · Observation <time datetime="2026-09-05T12:00:00Z">Sat, 05 Sep 2026 12:00:00 GMT</time><p>impact</p></li></ul></div></section>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarDisclosure: closed and open > closed 1`] = `"<section><button type="button" aria-expanded="false" aria-controls="details-content"><span><span>Details and history</span><span>Explore solar history</span></span><span aria-hidden="true">+</span></button></section>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarDisclosure: closed and open > open 1`] = `"<section><button type="button" aria-expanded="true" aria-controls="details-content"><span><span>Details and history</span><span>Explore solar history</span></span><span aria-hidden="true">−</span></button><div id="details-content"><p>Body</p></div></section>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarImageCard: a freshly loaded image 1`] = `"<article><div><img src="/api/solar/image?product=sunspot-hmi&amp;refresh=5962038-0" alt="NASA SDO HMI full solar disk showing visible sunspots" loading="lazy" decoding="async"><span>Current</span></div><div><div><div><h3>SDO HMI sunspots</h3><p>Latest SDO HMI continuum image for visible sunspot structure.</p></div><button type="button">Enlarge</button></div><div><span>Image time 2m ago</span><div><a href="https://sdo.gsfc.nasa.gov/data/" target="_blank" rel="noreferrer">NASA SDO</a></div></div></div></article>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarImageDetail: a freshly loaded image with its observation time 1`] = `"<div><div><img src="/api/solar/image?product=sunspot-hmi&amp;refresh=5962038-0" alt="NASA SDO HMI full solar disk showing visible sunspots" decoding="async"></div><div><span>Image time Sep 5, 12:28 PM UTC Legends and map edges remain intact.</span><a href="https://sdo.gsfc.nasa.gov/data/" target="_blank" rel="noreferrer">View source at NASA SDO</a></div></div>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarMiniChart: an observed series with a Kp storm threshold 1`] = `"<figure><figcaption>Recent Kp intervals</figcaption><svg viewBox="0 0 300 88" role="img" aria-labelledby=":r0:-title :r0:-desc"><title id=":r0:-title">Recent Kp intervals</title><desc id=":r0:-desc">Sep 5, 09:00 to Sep 5, 15:00 UTC. Range 0 to 9 Kp. Gaps indicate missing intervals. Detailed values are available in the charts below.</desc><line x1="32" x2="284" y1="66" y2="66" stroke-opacity=".35"></line><text x="0" y="16" font-size="9">9</text><text x="0" y="67" font-size="9">0</text><rect x="32" y="48" width="124" height="18" rx="1"><title>Sep 5, 09:00 UTC: 3 Kp · observed</title></rect><rect x="158" y="36" width="124" height="30" rx="1"><title>Sep 5, 12:00 UTC: 5 Kp · observed</title></rect><line x1="32" x2="284" y1="36" y2="36" stroke-dasharray="3 3"></line><text x="283" y="33" text-anchor="end" font-size="9">Kp 5</text><text x="32" y="82" font-size="9">09-05 09:00</text><text x="284" y="82" text-anchor="end" font-size="9">09-05 15:00</text></svg><p>Kp · UTC · observed / estimated</p></figure>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarOperatingActions: the full handoff nav 1`] = `"<div><p>Portable kit · EM10 · CW</p><nav aria-label="Continue operating"><a href="/map" data-discover="true">Inspect a path</a><a href="/dx" data-discover="true">Find a band for a target</a><a href="/planner" data-discover="true">Plan a session</a></nav></div>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > SolarSeriesChart: observed and predicted points with a threshold and the values table open 1`] = `"<div><div role="region" aria-label="Planetary Kp plot; scroll horizontally on a narrow screen" tabindex="0"><svg viewBox="0 0 720 220" role="img" aria-label="Planetary Kp. 2 records from 2026-09-05T09:00:00.000Z to 2026-09-05T15:00:00.000Z."><g><line x1="66" x2="698" y1="175" y2="175"></line><text x="58" y="179" text-anchor="end" font-size="12">0</text></g><g><line x1="66" x2="698" y1="137.5" y2="137.5"></line><text x="58" y="141.5" text-anchor="end" font-size="12">2.25</text></g><g><line x1="66" x2="698" y1="100" y2="100"></line><text x="58" y="104" text-anchor="end" font-size="12">4.5</text></g><g><line x1="66" x2="698" y1="62.5" y2="62.5"></line><text x="58" y="66.5" text-anchor="end" font-size="12">6.75</text></g><g><line x1="66" x2="698" y1="25" y2="25"></line><text x="58" y="29" text-anchor="end" font-size="12">9</text></g><text x="66" y="14" font-size="12">Kp</text><line data-zero-line="true" x1="66" x2="698" y1="175" y2="175" stroke-dasharray="4 4"></line><g><line x1="66" x2="698" y1="91.66666666666666" y2="91.66666666666666" stroke-dasharray="2 5"></line><text x="694" y="86.66666666666666" text-anchor="end" font-size="12">Storm range</text></g><text x="66" y="200" text-anchor="start" font-size="12">09-05 09:00Z</text><text x="276.66666666666663" y="200" text-anchor="middle" font-size="12">09-05 11:00Z</text><text x="487.3333333333333" y="200" text-anchor="middle" font-size="12">09-05 13:00Z</text><text x="698" y="200" text-anchor="end" font-size="12">09-05 15:00Z</text><g data-kind="observed"><circle cx="66" cy="125.00000000000001" r="3"></circle></g><g data-kind="predicted"><circle cx="698" cy="91.66666666666666" r="3"></circle></g><g><line x1="434.6666666666667" x2="434.6666666666667" y1="25" y2="175" stroke-dasharray="2 4"></line><text x="438.6666666666667" y="37" font-size="12">Now</text></g><circle cx="698" cy="91.66666666666666" r="5" stroke-width="2"></circle></svg></div><div><span><span aria-hidden="true">━ </span>Observed</span><span><span aria-hidden="true">┅ </span>Official NOAA prediction</span></div><label for=":r1:-inspect">Inspect Planetary Kp — drag or use arrow keys</label><input id=":r1:-inspect" type="range" min="0" max="1" step="1" aria-valuetext="2026-09-05T15:00:00.000Z: 5 Kp, predicted" value="1"><output for=":r1:-inspect" aria-live="polite">2026-09-05T15:00:00.000Z: 5 Kp, predicted</output><button type="button" aria-expanded="true" aria-controls=":r1:-values">Hide values</button><div id=":r1:-values" tabindex="0" role="region" aria-label="Planetary Kp values"><table><caption>Planetary Kp records</caption><thead><tr><th scope="col">Time (UTC)</th><th scope="col">Kp</th><th scope="col">Record</th></tr></thead><tbody><tr><td>2026-09-05T09:00:00.000Z</td><td>3</td><td>observed</td></tr><tr><td>2026-09-05T15:00:00.000Z</td><td>5</td><td>predicted</td></tr></tbody></table></div></div>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > WidgetShell: error fallback with the retry control 1`] = `"<section aria-label="Solar flux"><header><div><h2 title="Solar flux">Solar flux</h2><div></div></div><div><span role="status" aria-live="polite"><span aria-hidden="true">◇</span>Error</span></div></header><div><div><p>Error</p><p>No recent reading is available yet. Propulse checks for updates automatically.</p><button type="button">Try again</button></div></div></section>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > WidgetShell: fresh state with an eyebrow, timestamp, and action 1`] = `"<section aria-label="Planetary Kp"><header><div><p title="3-hour observed">3-hour observed</p><h2 title="Planetary Kp">Planetary Kp</h2><div><time datetime="2026-09-05T12:00:00Z" title="2026-09-05T12:00:00.000Z">Observed 30m ago</time><a href="https://example.test" target="_blank" rel="noreferrer" title="NOAA SWPC">NOAA SWPC</a></div></div><div><span role="status" aria-live="polite"><span aria-hidden="true">●</span>Current</span></div></header><div><p>3.2</p></div><div><button type="button">Explain</button></div></section>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > WidgetShell: loading state 1`] = `"<section aria-label="IMF Bz"><header><div><h2 title="IMF Bz">IMF Bz</h2><div></div></div><div><span role="status" aria-live="polite"><span aria-hidden="true">◇</span>Loading</span></div></header><div><div><div aria-label="Loading data"><div></div></div></div></div></section>"`;

exports[`Solar Pulse structural snapshot (DS-03 retheme) > WidgetShell: stale banner above the retained reading 1`] = `"<section aria-label="Solar flux"><header><div><h2 title="Solar flux">Solar flux</h2><div></div></div><div><span role="status" aria-live="polite"><span aria-hidden="true">◇</span>Stale</span></div></header><div>This reading is older than expected. Propulse checks for updates automatically.</div><div><p>—</p></div></section>"`;
